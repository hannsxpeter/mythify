{
  "schema_version": 1,
  "gates": [
    {
      "id": "python_tests",
      "label": "Python test suite",
      "required": true,
      "sources": [
        "tests/"
      ],
      "commands": [
        "python3 -m unittest discover -s tests -v"
      ]
    },
    {
      "id": "distribution_tests",
      "label": "Installer, MCP server, and release artifact tests",
      "required": true,
      "sources": [
        "tests/test_install_user.py",
        "tests/test_release_checksums.py",
        "tests/test_mcp_server.py",
        "tests/test_release_version.py"
      ],
      "commands": [
        "python3 -m unittest tests.test_install_user tests.test_release_checksums tests.test_mcp_server tests.test_release_version -v"
      ]
    },
    {
      "id": "prose_quality",
      "label": "Mechanical prose quality check",
      "required": true,
      "sources": [
        "protocol/prose-quality.json",
        "scripts/check_prose_quality.py",
        "skills/mythify/references/communication-quality.md",
        "docs/prose-quality.md",
        "tests/test_prose_quality.py"
      ],
      "commands": [
        "python3 scripts/check_prose_quality.py"
      ]
    },
    {
      "id": "runtime_source_size",
      "label": "Runtime source size guard",
      "required": true,
      "sources": [
        "scripts/check_runtime_source_size.py",
        "tests/test_runtime_source_size.py"
      ],
      "commands": [
        "python3 scripts/check_runtime_source_size.py"
      ]
    },
    {
      "id": "protocol_check",
      "label": "Protocol variants check",
      "required": true,
      "sources": [
        "protocol/PROTOCOL.md",
        "AGENTS.md",
        "CLAUDE.md",
        ".cursorrules"
      ],
      "commands": [
        "python3 scripts/mythify.py protocol check CLAUDE.md AGENTS.md .cursorrules"
      ]
    },
    {
      "id": "whitespace",
      "label": "Whitespace check",
      "required": true,
      "sources": [
        "git diff --check"
      ],
      "commands": [
        "git diff --check"
      ]
    },
    {
      "id": "release_tag",
      "label": "Release tag and CLI version check",
      "required": true,
      "sources": [
        "scripts/package_cli.py"
      ],
      "commands": [
        "python3 scripts/package_cli.py --check-release-tag v5.8.0"
      ]
    },
    {
      "id": "release_assets",
      "label": "Flat release asset checksum check",
      "required": true,
      "sources": [
        "scripts/build_release_checksums.py",
        ".github/workflows/release.yml"
      ],
      "commands": [
        "python3 scripts/build_release_checksums.py --check dist/release-assets/SHA256SUMS --directory dist/release-assets"
      ]
    }
  ]
}
