    "detected_reason": "The prompt asks for an open-ended quality climb toward a reference bar, not a machine-checkable done-condition.",
    "not_detected_reason": "No open-ended quality-climb language detected.",
    "protocol": "Split builder work across whatever subagents the host offers (or none), add one separate harsh critic that blind-compares the integrated deliverable side by side with the named reference, record critic verdicts as material with verify claim, keep any executable checks as verify run gates, and state an explicit budget up front: the reference bar stays out of reach by design, so the budget or the human is the brake."
  },
  "execution_profile": {
    "direct_reason": "No protocol state is needed for a simple answer or one reversible edit.",
    "full_reason": "High-risk or heavy work needs the full plan, verify, reflect, and state loop.",
    "ambiguous_reason": "Ambiguous work needs framing or a plan before execution.",
    "fast_reason": "Focused low-risk work can skip plan state but must still use verify run.",
    "light_reason": "Light work can use the fast profile unless it expands into multiple steps.",
    "standard_reason": "Use a plan with verifiable steps and verify run before completion.",
    "fast_task_types": [
      "bugfix",
      "test_generation"
    ],
    "fast_focused_task_types": [
      "docs",
      "refactor"
    ],
    "focused_terms": [
